{
  "name": "sort-showdown",
  "version": "1.0.0",
  "private": true,
  "description": "A browser game in which the player races an automated opponent to sort dice into ascending order, built around a hand-written quicksort.",
  "keywords": [
    "game",
    "quicksort",
    "sorting-algorithm",
    "drag-and-drop",
    "accessibility",
    "vanilla-javascript",
    "scss"
  ],
  "homepage": "https://adherlycisneros.github.io/sort-showdown/",
  "repository": {
    "type": "git",
    "url": "https://github.com/adherlycisneros/sort-showdown.git"
  },
  "scripts": {
    "build:css": "sass src/styles/styles.scss src/styles/styles.css",
    "watch:css": "sass --watch src/styles/styles.scss:src/styles/styles.css"
  },
  "author": "Adherly Cisneros",
  "license": "MIT",
  "devDependencies": {
    "sass": "^1.77.8"
  }
}
